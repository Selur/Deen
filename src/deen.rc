#include <winver.h>
#include "version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DEEN_VERSION_MAJOR, DEEN_VERSION_MINOR, DEEN_VERSION_PATCH, 0
PRODUCTVERSION DEEN_VERSION_MAJOR, DEEN_VERSION_MINOR, DEEN_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Selur"
      VALUE "FileDescription", "Deen: spatial and spatio-temporal denoiser (clean-room Deen 1.0 beta 1) for AviSynth+ and VapourSynth"
      VALUE "FileVersion", DEEN_VERSION
      VALUE "InternalName", "Deen"
      VALUE "LegalCopyright", "(c) 2026 Selur, MIT"
      VALUE "OriginalFilename", "Deen.dll"
      VALUE "ProductName", "Deen"
      VALUE "ProductVersion", DEEN_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
